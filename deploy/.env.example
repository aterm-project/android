# Host port is published on 127.0.0.1 only. Put a TLS reverse proxy in front
# when exposing the service to other machines.
ATERMIUS_HOST_PORT=8080
ATERMIUS_DATA_VOLUME_NAME=atermius-data
# Optional Caddy HTTPS edge overlay. Set a DNS name that resolves to this
# host and an ACME contact; keep the browser origin exactly aligned. The
# overlay removes the server's published port and publishes only Caddy.
# ATERMIUS_CADDY_DOMAIN=termius.example.org
# ATERMIUS_CADDY_ACME_EMAIL=admin@example.org
# ATERMIUS_PUBLIC_ORIGIN=https://termius.example.org
# ATERMIUS_CADDY_HTTP_HOST_PORT=80
# ATERMIUS_CADDY_HTTPS_HOST_PORT=443
# These paths normally stay at their defaults. The offline restore-cutover
# coordinator updates all three values together when activating a staged copy.
ATERMIUS_DATA_DIR=/data
ATERMIUS_DATABASE_URL=sqlite:///data/atermius.db?mode=rwc
# Optional bind-mount sources used only with compose.backup.yaml. Create both
# directories first and restrict them to the server UID (10001), mode 0700.
ATERMIUS_BACKUP_ARCHIVE_HOST_DIR=/srv/atermius-backups
ATERMIUS_BACKUP_KEY_HOST_DIR=/srv/atermius-backup-key
# Optional: keep this many newest server-triggered archives (1..1000).
# Leave commented/unset to disable automatic archive pruning.
# ATERMIUS_BACKUP_RETENTION_COUNT=10

# Optional single-server PostgreSQL runtime and offline restore cutover.
# Use compose.backup.yaml, compose.object-store-filesystem.yaml and
# compose.postgres.yaml in that order after provisioning the protected files.
# The restore next target is coordinator-only and must never be added as a
# Compose service environment variable.
# ATERMIUS_SYNC_BACKEND=postgres
# ATERMIUS_SYNC_PG_URL=postgresql://atermius@db.example:5432/atermius_source
# ATERMIUS_SYNC_PG_SCHEMA=atermius
# ATERMIUS_PG_RESTORE_TARGET_URL=postgresql://atermius@db.example:5432/atermius_restore_stage
# ATERMIUS_PG_RESTORE_NEXT_TARGET_URL=postgresql://atermius@db.example:5432/atermius_restore_next
# ATERMIUS_PG_INSTANCE_SIGNING_KEY_FILE=/run/secrets/atermius-pg-instance-ed25519.key
# ATERMIUS_PG_AUTH_RATE_LIMIT_KEY_FILE=/run/secrets/atermius-pg-auth-rate-limit.key
# ATERMIUS_PG_INSTANCE_SIGNING_KEY_HOST_FILE=/srv/atermius-pg-keys/instance-ed25519.key
# ATERMIUS_PG_AUTH_RATE_LIMIT_KEY_HOST_FILE=/srv/atermius-pg-keys/auth-rate-limit.key
# ATERMIUS_OBJECT_STORE_FILESYSTEM_ROOT=/object-store
# ATERMIUS_OBJECT_STORE_FILESYSTEM_VOLUME_NAME=atermius-object-store

# Optional S3-compatible encrypted archive replication. Uncomment only after
# provisioning the private credentials JSON file described in deploy/README.md.
# ATERMIUS_BACKUP_S3_BUCKET=atermius-backups
# ATERMIUS_BACKUP_S3_REGION=us-east-1
# ATERMIUS_BACKUP_S3_CREDENTIALS_HOST_FILE=/srv/atermius-backup-s3/credentials.json
# ATERMIUS_BACKUP_S3_ENDPOINT_URL=https://s3.example.net
# ATERMIUS_BACKUP_S3_PREFIX=atermius/production

# Optional mobile background sync hints using FCM HTTP v1 and/or APNs. Keep
# both provider credentials private and apply each provider's Compose overlay.
# ATERMIUS_FCM_SERVICE_ACCOUNT_HOST_FILE=/srv/atermius-fcm/service-account.json
# ATERMIUS_APNS_PRIVATE_KEY_HOST_FILE=/srv/atermius-apns/AuthKey_0123456789.p8
# ATERMIUS_APNS_TEAM_ID=replace-with-your-team-id
# ATERMIUS_APNS_KEY_ID=replace-with-your-key-id
# ATERMIUS_APNS_TOPIC=com.example.atermius
# Set true only for Apple sandbox device tokens; unset uses production.
# ATERMIUS_APNS_USE_SANDBOX=true

# Optional S3-compatible store for client-encrypted Vault attachment objects.
# This is separate from encrypted .atb backup replication above. Uncomment only
# after provisioning the private credentials JSON file described in deploy/README.md.
# ATERMIUS_OBJECT_STORE_S3_BUCKET=atermius-objects
# ATERMIUS_OBJECT_STORE_S3_REGION=us-east-1
# ATERMIUS_OBJECT_STORE_S3_CREDENTIALS_HOST_FILE=/srv/atermius-object-store-s3/credentials.json
# ATERMIUS_OBJECT_STORE_S3_ENDPOINT_URL=https://s3.example.net
# ATERMIUS_OBJECT_STORE_S3_PREFIX=atermius/production

# Optional dedicated local-filesystem store for new client-encrypted Vault
# attachment objects. Use compose.object-store-filesystem.yaml instead of the
# S3 overlay; do not enable both backends on one server.
ATERMIUS_OBJECT_STORE_FILESYSTEM_VOLUME_NAME=atermius-object-store

# Optional Prometheus collector overlay. Create this credentials directory with
# the ownership and permissions documented in deploy/README.md first.
# ATERMIUS_PROMETHEUS_HOST_PORT=9090
# ATERMIUS_PROMETHEUS_CREDENTIALS_HOST_DIR=/srv/atermius-prometheus-secrets

# Optional single-instance Alertmanager webhook overlay. Store the protected
# webhook URL only in the file documented in deploy/README.md, never here.
# ATERMIUS_ALERTMANAGER_WEBHOOK_HOST_DIR=/srv/atermius-alertmanager-secrets

# Optional Grafana dashboard overlay. Apply compose.grafana.yaml only together
# with compose.prometheus.yaml. Keep the admin password in this protected file.
# ATERMIUS_GRAFANA_HOST_PORT=3000
# ATERMIUS_GRAFANA_ADMIN_PASSWORD_HOST_DIR=/srv/atermius-grafana-secrets

ATERMIUS_HISTORY_RETENTION_DAYS=90
ATERMIUS_VAULT_DELETION_GRACE_SECONDS=604800
ATERMIUS_ACCOUNT_DELETION_GRACE_SECONDS=604800
ATERMIUS_AUDIT_RETENTION_DAYS=365
ATERMIUS_OBJECT_GC_GRACE_SECONDS=604800
ATERMIUS_MAX_VAULTS_PER_USER=50
ATERMIUS_MAX_MEMBERS_PER_VAULT=100
# Maximum concurrent unexpired, unconsumed Recovery challenges (1..100000).
ATERMIUS_MAX_ACTIVE_RECOVERY_CHALLENGES=10000

# Optional instance-wide, read-only admin API access. Values must be the
# normalized lowercase account usernames (email-like values), comma-separated.
# Empty means no instance-admin endpoints are enabled.
# Any malformed entry fails closed by disabling the whole allowlist.
ATERMIUS_ADMIN_USERNAMES=

# Authentication attempt limits per fixed window. Defaults: 15 minutes;
# login user/pair/IP 12/8/3000; prelogin 30/20/6000; registration 3/3/60.
# A user+peer pair scopes a single username from consuming the shared IP budget.
ATERMIUS_AUTH_RATE_WINDOW_SECONDS=900
ATERMIUS_AUTH_LOGIN_USER_LIMIT=12
ATERMIUS_AUTH_LOGIN_PAIR_LIMIT=8
ATERMIUS_AUTH_LOGIN_IP_LIMIT=3000
ATERMIUS_AUTH_PRELOGIN_USER_LIMIT=30
ATERMIUS_AUTH_PRELOGIN_PAIR_LIMIT=20
ATERMIUS_AUTH_PRELOGIN_IP_LIMIT=6000
ATERMIUS_AUTH_REGISTER_USER_LIMIT=3
ATERMIUS_AUTH_REGISTER_PAIR_LIMIT=3
ATERMIUS_AUTH_REGISTER_IP_LIMIT=60

# Relay is deliberately disabled until an administrator supplies narrow target
# CIDR and exact-port allowlists, plus the hosted Web client's public origin.
ATERMIUS_RELAY_ENABLED=false
ATERMIUS_RELAY_ALLOW_CIDRS=
ATERMIUS_RELAY_ALLOW_PORTS=
ATERMIUS_PUBLIC_ORIGIN=

# Optional TOTP MFA seed-encryption key directory (32-byte mode-0600 file).
# ATERMIUS_MFA_KEY_HOST_DIR=/srv/atermius-mfa-key

# Optional cloud gateway: these fields are consumed by compose.share.yaml.
# Basic SQLite organization creation defaults to configured instance admins.
# See docs/INSTALLATION.md and docs/CLOUD-SHARING.md before enabling the overlay.
ATERMIUS_SHARE_LINKS_ENABLED=false
ATERMIUS_SHARE_ALLOW_CIDRS=
ATERMIUS_SHARE_ALLOW_PORTS=22,3389
ATERMIUS_SHARE_DENY_CIDRS=172.16.0.0/12
ATERMIUS_SHARE_VNC_ENABLED=false
ATERMIUS_ORGANIZATIONS_ENABLED=true
ATERMIUS_ORG_CREATION=admin
# ATERMIUS_SHARE_GATEWAY_KEY_VOLUME_NAME=atermius-share-gateway-key
